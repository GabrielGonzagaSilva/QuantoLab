{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quantolab",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/analytics/*"
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "quantolab_product_events"
    }
  ]
}
